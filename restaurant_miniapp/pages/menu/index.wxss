.opt-mask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.55);display:flex;align-items:flex-end;z-index:1000;}
.opt-panel{background:#fff;width:100%;border-radius:18rpx 18rpx 0 0;padding:24rpx;}
.opt-row{display:flex;align-items:center;gap:16rpx;padding:12rpx 0;border-bottom:1px solid #f2f2f2;}

