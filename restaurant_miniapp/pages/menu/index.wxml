<view class="container">
  <view class="card">
    <view class="row">
      <view>
        <view class="muted">桌台</view>
        <view style="font-weight:700">{{tableName}}</view>
      </view>
      <view>
        <button class="btn btn-outline" size="mini" bindtap="goCart">购物车</button>
      </view>
    </view>
  </view>

  <scroll-view scroll-x class="card" style="white-space:nowrap">
    <view style="display:flex;gap:16rpx">
      <block wx:for="{{categories}}" wx:key="id">
        <button class="btn {{currentCatId==item.id?'btn-primary':'btn-ghost'}}" size="mini" data-id="{{item.id}}" bindtap="switchCat">{{item.name}}</button>
      </block>
    </view>
  </scroll-view>

  <view class="card" wx:if="{{combos.length}}">
    <view style="font-weight:700;margin-bottom:16rpx">套餐</view>
    <block wx:for="{{combos}}" wx:key="id">
      <view style="padding:18rpx 0;border-top:1px solid #eee" wx:if="{{index>0}}"></view>
      <view class="row">
        <view style="max-width:520rpx">
          <view style="font-weight:700">{{item.name}}<text class="tag">套餐</text></view>
          <view class="muted" style="font-size:24rpx">{{item.itemsText}}</view>
          <view class="muted">¥{{item.price}}</view>
        </view>
        <view>
          <button class="btn btn-primary" size="mini" data-id="{{item.id}}" bindtap="addCombo">加入</button>
        </view>
      </view>
    </block>
  </view>

  <view class="card" wx:if="{{items.length}}">
    <view style="font-weight:700;margin-bottom:16rpx">菜品</view>
    <block wx:for="{{items}}" wx:key="id">
      <view style="padding:18rpx 0;border-top:1px solid #eee" wx:if="{{index>0}}"></view>
      <view class="row">
        <view style="max-width:520rpx">
          <view style="font-weight:700">{{item.name}}</view>
          <view class="muted">¥{{item.price}}</view>
        </view>
        <view>
          <button class="btn {{item.hasOptions?'btn-outline':'btn-primary'}}" size="mini" data-id="{{item.id}}" bindtap="tapItem">{{item.hasOptions?'选规格':'加入'}}</button>
        </view>
      </view>
    </block>
  </view>

  <view class="card muted" wx:if="{{!items.length && !combos.length}}">暂无可售商品</view>

  <view wx:if="{{showOpt}}" class="opt-mask" catchtouchmove="noop">
    <view class="opt-panel">
      <view style="font-weight:700;margin-bottom:10rpx">{{optItem.name}}</view>
      <scroll-view scroll-y style="max-height:58vh">
        <block wx:for="{{optGroups}}" wx:key="id">
          <view style="margin-top:16rpx">
            <view style="font-weight:700">{{item.name}}（{{item.ruleText}}）</view>
            <view style="margin-top:10rpx">
              <block wx:for="{{item.options}}" wx:key="id">
                <label class="opt-row">
                  <checkbox value="{{item.id}}" checked="{{item.checked}}" data-gid="{{item.group_id}}" bindchange="toggleOption"/>
                  <view style="flex:1">{{item.name}}<text class="muted" wx:if="{{item.price_delta!=0}}"> +{{item.price_delta}}</text></view>
                </label>
              </block>
            </view>
          </view>
        </block>
      </scroll-view>
      <view class="row" style="margin-top:16rpx">
        <button class="btn btn-outline" size="mini" bindtap="closeOpt">取消</button>
        <button class="btn btn-primary" size="mini" bindtap="confirmOpt">加入购物车</button>
      </view>
    </view>
  </view>
</view>

