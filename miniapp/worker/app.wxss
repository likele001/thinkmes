page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}
.container {
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.btn-primary {
  background: linear-gradient(135deg, #1989fa 0%, #0d7de0 100%);
  color: #fff;
  border-radius: 12rpx;
  text-align: center;
  padding: 24rpx;
}
.btn-primary:active { opacity: 0.9; }
.text-muted { color: #999; font-size: 24rpx; }
.text-primary { color: #1989fa; }
