<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goIndex">← 首页</view>
    <text class="page-title">售后管理</text>
  </view>
  <view class="btn-bar-admin">
    <button class="btn-primary" bindtap="goAdd">新增售后</button>
  </view>
  <view class="list-item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}">
    <view class="row" bindtap="goDetail" data-id="{{item.id}}"><text class="title">{{item.order_no || item.sn || item.title || '售后'}}</text></view>
    <view class="text-muted">客户：{{item.customer_name || '-'}} 状态：{{item.status_text || item.status}}</view>
    <view class="btn-wrap">
      <button data-id="{{item.id}}" catchtap="goDetail">详情</button>
      <button data-id="{{item.id}}" catchtap="goEdit">编辑</button>
      <button type="warn" data-id="{{item.id}}" catchtap="confirmDelete">删除</button>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && list.length===0}}">暂无售后记录</view>
  <view class="no-more" wx:if="{{noMore && list.length>0}}">没有更多了</view>
</view>
