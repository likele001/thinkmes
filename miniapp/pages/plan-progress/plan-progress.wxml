<view class="container">
  <view class="card" wx:if="{{plan}}">
    <view class="row"><text class="label">计划</text><text>{{plan.plan_name || plan.plan_code}}</text></view>
    <view class="row" wx:if="{{plan.model}}"><text class="label">产品型号</text><text>{{plan.model.product ? plan.model.product.name : ''}} - {{plan.model.name || ''}}</text></view>
  </view>
  <view class="card progress-card">
    <view class="stat-row"><text class="label">计划数量</text><text class="value">{{progress.total_quantity != null ? progress.total_quantity : (plan && plan.total_quantity) || 0}}</text></view>
    <view class="stat-row"><text class="label">已完成</text><text class="value">{{progress.completed_quantity != null ? progress.completed_quantity : '-'}}</text></view>
    <view class="stat-row"><text class="label">已报工数</text><text class="value">{{progress.reported_quantity != null ? progress.reported_quantity : '-'}}</text></view>
    <view class="stat-row"><text class="label">完成进度</text><text class="value highlight">{{progress.progress != null ? progress.progress + '%' : '-'}}</text></view>
  </view>
  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
