<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">计划进度</text>
  </view>
  <view class="card" wx:if="{{planId}}">
    <view class="card-title">进度明细</view>
    <view class="list-item" wx:for="{{list}}" wx:key="id">
      <view class="row"><text class="title">{{item.process_name || '工序'}}</text><text class="value">完成 {{item.finished_quantity || 0}} / {{item.plan_quantity || 0}}</text></view>
      <view class="text-muted">{{item.user_name || ''}} {{item.createtime_text || ''}}</view>
    </view>
    <view class="empty" wx:if="{{!loading && list.length===0}}">暂无进度</view>
  </view>
</view>
