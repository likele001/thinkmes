/* ========== 员工首页 - 与 PC 端一致 ========== */
.user-index .container {
  padding: 28rpx 24rpx 120rpx;
}

/* 欢迎区 */
.user-index .welcome-card {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(79, 70, 229, 0.3);
}

.user-index .welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.user-index .welcome-date {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 今日三指标（与 PC 三色块一致） */
.user-index .stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.user-index .stat-card {
  flex: 1;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.user-index .stat-tasks {
  background: linear-gradient(145deg, #4f46e5, #6366f1);
  color: #fff;
}

.user-index .stat-reports {
  background: linear-gradient(145deg, #059669, #10b981);
  color: #fff;
}

.user-index .stat-wage {
  background: linear-gradient(145deg, #6f42c1, #8b5cf6);
  color: #fff;
}

.user-index .stat-num {
  font-size: 36rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 8rpx;
}

.user-index .stat-label {
  font-size: 22rpx;
  opacity: 0.95;
}

.user-index .loading-card {
  margin-bottom: 28rpx;
  text-align: center;
  color: #64748b;
}

/* 区块标题 */
.user-index .section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  padding: 24rpx 0 20rpx;
  margin-top: 8rpx;
}

/* 功能入口六宫格（与 PC 一致） */
.user-index .menu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.user-index .menu-tile {
  width: calc(33.333% - 14rpx);
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.user-index .menu-tile-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.user-index .menu-tile-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 4rpx;
}

.user-index .menu-tile-desc {
  font-size: 20rpx;
  color: #64748b;
}

/* 快捷操作（与 PC 一致） */
.user-index .quick-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}

.user-index .quick-btn {
  flex: 1;
  min-width: calc(33.333% - 14rpx);
  padding: 24rpx 20rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.user-index .quick-btn.primary {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.3);
}

.user-index .quick-btn.success {
  background: linear-gradient(135deg, #059669, #10b981);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(5, 150, 105, 0.3);
}

.user-index .quick-btn.outline {
  background: #fff;
  color: #4f46e5;
  border: 2rpx solid #6366f1;
}

/* 任务卡片 */
.user-index .task-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border-left: 6rpx solid #6366f1;
}

.user-index .task-name {
  font-weight: 700;
  font-size: 30rpx;
  color: #1e293b;
  margin-bottom: 10rpx;
}

.user-index .task-qty {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #64748b;
}

.user-index .empty {
  text-align: center;
  color: #94a3b8;
  padding: 60rpx 32rpx;
  font-size: 28rpx;
}
