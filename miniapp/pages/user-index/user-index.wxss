/* 员工首页 - 参考 adminweixin 风格 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  padding-bottom: 40rpx;
  position: relative;
}

.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
  padding: 20rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.nav-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea, #764ba2);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.nav-actions { display: flex; align-items: center; gap: 16rpx; }

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}
.nav-btn:active { transform: scale(0.95); }
.nav-icon { font-size: 32rpx; }

.main-content {
  padding-top: 120rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
  position: relative;
  z-index: 1;
}

.user-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.user-header { display: flex; align-items: center; }
.user-avatar { margin-right: 28rpx; }
.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}
.avatar-text { font-size: 40rpx; font-weight: 700; color: #fff; }
.user-info { flex: 1; }
.user-name { display: block; font-size: 34rpx; font-weight: 700; color: #333; margin-bottom: 8rpx; }
.user-id { display: block; font-size: 26rpx; color: #666; }

.stats-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.card-header { margin-bottom: 28rpx; }
.card-title { font-size: 32rpx; font-weight: 700; color: #333; }

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}
.stat-item:active { transform: scale(0.98); }
.stat-content { text-align: center; margin-bottom: 12rpx; }
.stat-number { display: block; font-size: 36rpx; font-weight: 800; color: #333; margin-bottom: 6rpx; }
.stat-label { display: block; font-size: 22rpx; color: #666; font-weight: 600; }
.stat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-text { font-size: 28rpx; }
.task-icon { background: linear-gradient(135deg, #667eea, #764ba2); }
.report-icon { background: linear-gradient(135deg, #f093fb, #f5576c); }
.wage-icon { background: linear-gradient(135deg, #4facfe, #00f2fe); }

.loading-wrap { text-align: center; padding: 60rpx; color: #fff; font-size: 28rpx; }

.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.action-item {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}
.action-item:active { transform: scale(0.98); }
.action-item.primary { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; }
.action-item.success { background: linear-gradient(135deg, #52c41a, #73d13d); color: #fff; }
.action-item.warning { background: linear-gradient(135deg, #faad14, #ffc53d); color: #fff; }
.action-item.info { background: linear-gradient(135deg, #1890ff, #40a9ff); color: #fff; }
.action-icon { font-size: 44rpx; margin-bottom: 12rpx; }
.action-text { font-size: 26rpx; font-weight: 600; }

.menu-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.section-header { margin-bottom: 24rpx; }
.section-title { display: block; font-size: 32rpx; font-weight: 700; color: #333; margin-bottom: 6rpx; }
.section-desc { display: block; font-size: 24rpx; color: #999; }

.task-list { display: flex; flex-direction: column; gap: 20rpx; }
.task-card {
  background: rgba(102, 126, 234, 0.06);
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.15);
}
.task-card:active { background: rgba(102, 126, 234, 0.12); }
.task-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.task-title { font-size: 30rpx; font-weight: 700; color: #333; flex: 1; margin-right: 16rpx; }
.task-status { padding: 8rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; }
.task-status.status-pending { background: #ff9500; color: #fff; }
.task-status.status-success { background: #34c759; color: #fff; }
.task-status-text { font-weight: 600; }
.task-info { display: flex; flex-direction: column; gap: 8rpx; }
.info-text { font-size: 24rpx; color: #666; }

.menu-section .empty { padding: 48rpx 0; }
