.filter-bar { display: flex; gap: 16rpx; margin-bottom: 24rpx; flex-wrap: wrap; }
.filter-bar .tab { padding: 12rpx 24rpx; border-radius: 8rpx; background: #f5f5f5; color: #666; }
.filter-bar .tab.active { background: var(--primary); color: #fff; }
.row { display: flex; justify-content: space-between; }
.title { font-weight: bold; }
.status-0 { color: #fa9d3b; }
.status-1 { color: #07c160; }
.status-2 { color: #ee0a24; }
.btn-wrap { margin-top: 16rpx; display: flex; gap: 16rpx; flex-wrap: wrap; }
.link-row { margin-top: 24rpx; text-align: center; }
.link-row navigator { color: var(--primary); }
.empty, .no-more { text-align: center; color: #999; padding: 32rpx; }
