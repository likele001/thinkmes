<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goIndex">← 首页</view>
    <text class="page-title">工资管理</text>
  </view>
  <view class="card stats" wx:if="{{stats && stats.list && stats.list.length}}">
    <view class="stats-title">工资统计（按人汇总）</view>
    <view class="text-muted">人数：{{stats.total || 0}}</view>
  </view>
  <view class="list-item" wx:for="{{list}}" wx:key="id">
    <view class="row"><text class="title">{{item.nickname || item.username || '用户'}} {{item.work_date || ''}}</text></view>
    <view class="text-muted">工资金额：¥{{item.total_wage || item.wage || 0}} 数量：{{item.quantity || 0}}</view>
  </view>
  <view class="empty" wx:if="{{!loading && list.length===0}}">暂无工资数据</view>
  <view class="no-more" wx:if="{{noMore && list.length>0}}">没有更多了</view>
</view>
