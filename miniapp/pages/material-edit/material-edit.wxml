<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">{{id ? '编辑物料' : '新增物料'}}</text>
  </view>
  <view class="card">
    <view class="form-item">
      <text class="form-label">物料名称 *</text>
      <input class="form-input" placeholder="物料名称" value="{{name}}" bindinput="inputName"/>
    </view>
    <view class="form-item">
      <text class="form-label">物料编码</text>
      <input class="form-input" placeholder="留空自动生成" value="{{code}}" bindinput="inputCode"/>
    </view>
    <view class="form-item">
      <text class="form-label">规格</text>
      <input class="form-input" placeholder="规格" value="{{spec}}" bindinput="inputSpec"/>
    </view>
    <view class="form-item">
      <text class="form-label">单位</text>
      <input class="form-input" placeholder="如 pcs、kg" value="{{unit}}" bindinput="inputUnit"/>
    </view>
    <view class="form-item">
      <text class="form-label">当前价格</text>
      <input class="form-input" type="digit" placeholder="当前价格" value="{{current_price}}" bindinput="inputCurrentPrice"/>
    </view>
    <view class="form-item">
      <text class="form-label">最低库存</text>
      <input class="form-input" type="number" placeholder="最低库存预警" value="{{min_stock}}" bindinput="inputMinStock"/>
    </view>
    <view class="form-item">
      <text class="form-label">状态</text>
      <picker mode="selector" range="{{statusList}}" range-key="text" value="{{statusIndex}}" bindchange="pickStatus">
        <view class="picker">{{statusText}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea class="form-input" placeholder="备注" value="{{remark}}" bindinput="inputRemark"/>
    </view>
  </view>
  <button class="btn-primary btn-block" loading="{{loading}}" bindtap="submit">{{id ? '保存' : '添加'}}</button>
</view>
