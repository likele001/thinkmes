.bi-page { padding: 24rpx; padding-bottom: 60rpx; }
.tabs { display: flex; background: #f5f5f5; border-radius: 12rpx; padding: 8rpx; margin-bottom: 24rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx; font-size: 26rpx; color: #666; border-radius: 8rpx; }
.tab.active { background: #1989fa; color: #fff; }
.tab-content { min-height: 200rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; color: #333; }
.row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #eee; font-size: 28rpx; }
.row .label { color: #666; }
.row .value { color: #333; font-weight: 500; }
.trend-item { display: flex; justify-content: space-between; padding: 12rpx 0; font-size: 26rpx; border-bottom: 1rpx solid #f0f0f0; }
.trend-item .date { color: #666; }
.trend-item .qty { color: #1989fa; }
.trend-item .wage { color: #07c160; }
.filter-row { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.picker { padding: 16rpx 24rpx; background: #fff; border-radius: 12rpx; font-size: 26rpx; border: 2rpx solid #eee; }
.to { font-size: 26rpx; color: #666; }
.btn-sm { padding: 16rpx 28rpx; font-size: 26rpx; background: #1989fa; color: #fff; border-radius: 12rpx; }
.list-card { overflow-x: auto; }
.table-row { display: flex; font-size: 24rpx; padding: 16rpx 0; border-bottom: 1rpx solid #eee; }
.table-row.head { font-weight: bold; color: #666; background: #f8f8f8; }
.table-row text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.table-row text.ellipsis { max-width: 140rpx; }
.empty, .loading { text-align: center; padding: 60rpx; color: #999; font-size: 28rpx; }
