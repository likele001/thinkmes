<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goIndex">← 首页</view>
    <text class="page-title">报工统计</text>
  </view>
  <view class="card">
    <view class="card-title">统计概览</view>
    <view class="filter-section">
      <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange"><view class="picker">开始：{{startDate}}</view></picker>
      <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange"><view class="picker">结束：{{endDate}}</view></picker>
      <button class="btn-primary" bindtap="load">查询</button>
    </view>
    <view class="metrics-section" wx:if="{{stats}}">
      <view class="metric-item"><text class="metric-value">{{stats.total_count || 0}}</text><text class="metric-label">报工笔数</text></view>
      <view class="metric-item"><text class="metric-value">¥{{stats.total_wage || 0}}</text><text class="metric-label">总工资</text></view>
      <view class="metric-item"><text class="metric-value">{{stats.passed_count || 0}}</text><text class="metric-label">已通过</text></view>
      <view class="metric-item"><text class="metric-value">{{stats.pending_count || 0}}</text><text class="metric-label">待审核</text></view>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && !stats}}">选择日期后点击查询</view>
</view>
