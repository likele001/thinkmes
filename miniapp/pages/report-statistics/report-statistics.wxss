.filter-row { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.picker { padding: 16rpx 24rpx; background: #fff; border-radius: 12rpx; font-size: 26rpx; border: 2rpx solid #eee; }
.to { font-size: 26rpx; color: #666; }
.btn-sm { padding: 16rpx 28rpx; font-size: 26rpx; background: #4f46e5; color: #fff; border-radius: 12rpx; }
.section-title { font-weight: bold; margin-bottom: 20rpx; }
.row { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #eee; }
.row .label { color: #666; }
.row .value { font-weight: 600; }
.empty, .loading { text-align: center; padding: 60rpx; color: #999; }
