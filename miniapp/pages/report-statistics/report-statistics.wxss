/* 报工统计 - adminweixin 风格 */

.metrics-section { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
.metric-item { flex: 1; min-width: 80px; padding: 12px; background: #f5f5f5; border-radius: 8px; text-align: center; }
.metric-value { display: block; font-size: 18px; font-weight: bold; color: #333; }
.metric-label { font-size: 12px; color: #666; }
