<view class="container admin-page" wx:if="{{detail}}">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">售后详情</text>
  </view>
  <view class="card">
    <view class="card-title">售后信息</view>
    <view class="row"><text class="label">订单号</text><text>{{detail.order_no || '-'}}</text></view>
    <view class="row"><text class="label">客户</text><text>{{detail.customer_name || '-'}}</text></view>
    <view class="row"><text class="label">状态</text><text>{{detail.status_text || (detail.status === 0 ? '待处理' : detail.status === 1 ? '处理中' : '已完成')}}</text></view>
    <view class="row" wx:if="{{detail.content}}"><text class="label">内容</text><text>{{detail.content}}</text></view>
    <view class="row" wx:if="{{detail.remark}}"><text class="label">备注</text><text>{{detail.remark}}</text></view>
    <view class="row" wx:if="{{detail.createtime_text}}"><text class="label">创建时间</text><text>{{detail.createtime_text}}</text></view>
  </view>
  <button class="btn-primary btn-block" bindtap="goEdit">编辑</button>
</view>
<view class="container admin-page" wx:elif="{{!loading}}">暂无数据</view>
<view class="container admin-page" wx:else>加载中...</view>
