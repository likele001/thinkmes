.login-page { padding: 60rpx 48rpx; }
.logo { font-size: 40rpx; font-weight: bold; color: #1989fa; margin-bottom: 48rpx; text-align: center; }
.mode-title { font-size: 30rpx; color: #666; margin-bottom: 32rpx; text-align: center; }
.mode-card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.mode-icon { font-size: 48rpx; margin-bottom: 16rpx; }
.mode-text { font-weight: bold; font-size: 32rpx; margin-bottom: 8rpx; }
.mode-desc { color: #999; font-size: 24rpx; }
.back-btn { color: #1989fa; margin-bottom: 24rpx; }
.form-title { font-size: 36rpx; margin-bottom: 48rpx; }
.form-item { margin-bottom: 24rpx; }
.form-item input { border: 2rpx solid #eee; border-radius: 12rpx; padding: 24rpx; }
.admin-form .btn-primary { margin-top: 32rpx; }
