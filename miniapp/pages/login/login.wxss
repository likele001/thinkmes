/* 登录页 - 参考 adminweixin 风格 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}

.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  animation: float 6s ease-in-out infinite;
}
.circle-1 { width: 200rpx; height: 200rpx; top: 10%; right: 10%; animation-delay: 0s; }
.circle-2 { width: 150rpx; height: 150rpx; bottom: 20%; left: 5%; animation-delay: 2s; }
.circle-3 { width: 100rpx; height: 100rpx; top: 60%; left: 20%; animation-delay: 4s; }
@keyframes float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20rpx) rotate(180deg); }
}

.login-mode-selector {
  text-align: center;
  z-index: 2;
  position: relative;
  width: 100%;
  max-width: 600rpx;
}

.logo-section { margin-bottom: 40rpx; }
.logo-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.logo-title { font-size: 44rpx; color: #fff; font-weight: 700; margin-bottom: 10rpx; }
.logo-subtitle { font-size: 24rpx; color: rgba(255,255,255,0.85); }

.mode-title {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 36rpx;
  font-weight: 600;
}

.mode-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
  overflow: hidden;
}
.mode-card:active { transform: scale(0.98); }

.card-content {
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
}
.mode-icon { font-size: 56rpx; margin-right: 24rpx; }
.mode-info { flex: 1; text-align: left; }
.mode-text { font-size: 30rpx; color: #333; font-weight: 600; margin-bottom: 8rpx; }
.mode-desc { font-size: 24rpx; color: #666; }
.card-arrow { font-size: 28rpx; color: #667eea; font-weight: bold; }

.login-form {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
  width: 100%;
  max-width: 600rpx;
  z-index: 2;
  position: relative;
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #eee;
}

.back-btn {
  display: flex;
  align-items: center;
  color: #667eea;
  font-size: 26rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(102, 126, 234, 0.1);
}
.back-btn:active { opacity: 0.8; }
.back-icon { font-size: 28rpx; margin-right: 8rpx; }
.form-title { font-size: 34rpx; color: #333; font-weight: 600; flex: 1; text-align: center; margin: 0 80rpx; }

.form-content .form-item { margin-bottom: 32rpx; }
.form-content .form-item:last-of-type { margin-bottom: 0; }

.input-wrapper {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid #eee;
  box-sizing: border-box;
}
.input-wrapper:focus-within {
  background: #fff;
  border-color: #667eea;
}
.input-icon { font-size: 32rpx; margin-right: 20rpx; flex-shrink: 0; }
.input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  padding: 0;
  font-size: 28rpx;
  color: #333;
  background: transparent;
}
.input-placeholder {
  color: #999 !important;
  font-size: 28rpx;
}

.btn-login {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-login:active { opacity: 0.9; }
