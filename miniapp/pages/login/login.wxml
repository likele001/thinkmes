<view class="container login-page">
  <view class="mode-select" wx:if="{{waitingAuto}}">
    <view class="logo">MES 工作台</view>
    <view class="mode-title">正在登录...</view>
  </view>
  <view class="mode-select" wx:elif="{{!selectedMode}}">
    <view class="logo">MES 工作台</view>
    <view class="mode-title">请选择身份</view>
    <view class="mode-card admin-card" bindtap="selectAdminMode">
      <view class="mode-icon">👨‍💼</view>
      <view class="mode-text">管理员登录</view>
      <view class="mode-desc">管理订单、分工、报工审核等</view>
    </view>
    <view class="mode-card user-card" bindtap="selectUserMode">
      <view class="mode-icon">👷</view>
      <view class="mode-text">员工登录</view>
      <view class="mode-desc">扫码报工、查看任务与工资</view>
    </view>
  </view>

  <view class="admin-form" wx:if="{{selectedMode === 'admin'}}">
    <view class="back-btn" bindtap="backToModeSelect">← 返回</view>
    <view class="form-title">管理员登录</view>
    <view class="form-item">
      <input placeholder="用户名" value="{{username}}" bindinput="inputUsername"/>
    </view>
    <view class="form-item">
      <input password placeholder="密码" value="{{password}}" bindinput="inputPassword"/>
    </view>
    <button class="btn-primary" loading="{{loading}}" bindtap="adminLogin">登录</button>
  </view>
</view>
