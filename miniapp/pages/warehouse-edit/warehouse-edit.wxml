<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">{{id ? '编辑仓库' : '新增仓库'}}</text>
  </view>
  <view class="card">
    <view class="form-item"><text class="form-label">仓库名称 *</text><input class="form-input" placeholder="名称" value="{{name}}" bindinput="inputName"/></view>
    <view class="form-item"><text class="form-label">编码</text><input class="form-input" placeholder="编码" value="{{code}}" bindinput="inputCode"/></view>
    <view class="form-item"><text class="form-label">地址</text><input class="form-input" placeholder="地址" value="{{address}}" bindinput="inputAddress"/></view>
  </view>
  <button class="btn-primary btn-block" loading="{{loading}}" bindtap="submit">{{id ? '保存' : '添加'}}</button>
</view>
