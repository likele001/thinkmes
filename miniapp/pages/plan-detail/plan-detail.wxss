/* 计划详情 - adminweixin 风格 */
.loading-tip { padding: 24px; text-align: center; color: #999; }
.progress-bar { margin: 12px 0; }
.progress-bg { height: 8px; background: #eee; border-radius: 4px; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #667eea, #764ba2); border-radius: 4px; }
