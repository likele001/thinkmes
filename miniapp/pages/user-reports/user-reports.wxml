<view class="page-container safe-area-top safe-area-bottom">
  <view class="top-nav">
    <view class="nav-title">报工记录</view>
    <view class="nav-actions" bindtap="refresh">
      <text class="nav-btn-text">刷新</text>
    </view>
  </view>

  <view class="main-content">
    <view class="stats-card" wx:if="{{!loading && (totalQuantity > 0 || totalWage > 0 || records.length > 0)}}">
      <view class="stats-header">
        <text class="stats-title">记录概览</text>
        <text class="stats-count">{{records.length}} 条</text>
      </view>
      <view class="stats-grid">
        <view class="stat-item">
          <view class="stat-content">
            <text class="stat-number">{{totalQuantity}}</text>
            <text class="stat-label">总报工数</text>
          </view>
          <view class="stat-icon quantity-icon"><text class="icon-text">数</text></view>
        </view>
        <view class="stat-item">
          <view class="stat-content">
            <text class="stat-number">¥{{totalWage}}</text>
            <text class="stat-label">总工资</text>
          </view>
          <view class="stat-icon wage-icon"><text class="icon-text">薪</text></view>
        </view>
        <view class="stat-item">
          <view class="stat-content">
            <text class="stat-number">{{pendingCount}}</text>
            <text class="stat-label">待审核</text>
          </view>
          <view class="stat-icon pending-icon"><text class="icon-text">待</text></view>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="skeleton-list">
      <view wx:for="{{[1,2,3]}}" wx:key="{{index}}" class="record-card skeleton-card">
        <view class="skeleton skeleton-title"></view>
        <view class="skeleton skeleton-row"></view>
        <view class="skeleton skeleton-row short"></view>
      </view>
    </view>

    <view wx:elif="{{records.length === 0}}" class="empty-wrap">
      <view class="empty-icon">📝</view>
      <text class="empty-title">暂无报工记录</text>
      <text class="empty-desc">您还没有提交过报工</text>
      <view class="empty-action" bindtap="refresh"><text class="action-text">刷新</text></view>
    </view>

    <view wx:else class="records-list">
      <view wx:for="{{records}}" wx:key="id" class="record-card" bindtap="goDetail" data-id="{{item.id || item.report_id}}">
        <view class="record-header">
          <view class="record-title">
            <text class="product-name">{{item.product_name || '产品'}} </text>
            <text class="model-name">{{item.model_name || ''}}</text>
          </view>
          <view class="record-status status-{{item.status}}">
            <text class="status-text">{{item.statusText || (item.status === 1 ? '已审核' : item.status === 2 ? '审核被拒绝' : '待审核')}}</text>
          </view>
        </view>
        <view class="record-info">
          <view class="info-row">
            <text class="info-label">订单</text>
            <text class="info-value">{{item.order_no || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">工序</text>
            <text class="info-value">{{item.process_name || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">数量</text>
            <text class="info-value">{{item.quantity}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">工资</text>
            <text class="info-value text-primary">¥{{item.wage || 0}}</text>
          </view>
        </view>
        <view class="record-footer">
          <text class="time-text">🕒 {{item.createtime_text || '暂无时间'}}
          </text>
        </view>
      </view>
    </view>

    <view wx:if="{{!loading && hasMore && records.length > 0}}" class="load-more" bindtap="loadMore">
      <text>加载更多</text>
    </view>
  </view>
</view>
