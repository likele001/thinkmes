/* 报工记录 - adminweixin 风格 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  padding-bottom: 40rpx;
}

.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  padding: 20rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.nav-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea, #764ba2);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.nav-actions { display: flex; align-items: center; }
.nav-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}
.nav-btn:active { transform: scale(0.95); }
.nav-icon { font-size: 32rpx; }

.main-content { padding-top: 120rpx; padding-left: 40rpx; padding-right: 40rpx; position: relative; z-index: 1; }

.stats-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stats-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.stats-title { font-size: 32rpx; font-weight: 700; color: #333; }
.stats-count { font-size: 26rpx; color: #666; }

.stats-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx; }
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}
.stat-content { text-align: center; margin-bottom: 8rpx; }
.stat-number { display: block; font-size: 32rpx; font-weight: 800; color: #333; }
.stat-label { display: block; font-size: 22rpx; color: #666; }
.stat-icon { width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.icon-text { font-size: 26rpx; }
.quantity-icon { background: linear-gradient(135deg, #667eea, #764ba2); }
.wage-icon { background: linear-gradient(135deg, #4facfe, #00f2fe); }
.pending-icon { background: linear-gradient(135deg, #faad14, #ffc53d); }

.loading-wrap { text-align: center; padding: 60rpx; color: #fff; font-size: 28rpx; }
.empty-wrap { text-align: center; padding: 80rpx 40rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { display: block; font-size: 32rpx; color: #fff; font-weight: 600; margin-bottom: 12rpx; }
.empty-desc { display: block; font-size: 26rpx; color: rgba(255,255,255,0.8); margin-bottom: 32rpx; }
.empty-action {
  display: inline-block;
  padding: 20rpx 48rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 40rpx;
  color: #667eea;
  font-size: 28rpx;
  font-weight: 600;
}
.action-text { color: inherit; }

.records-list { display: flex; flex-direction: column; gap: 24rpx; }
.record-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.record-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.record-title { flex: 1; margin-right: 16rpx; }
.product-name { font-size: 30rpx; font-weight: 700; color: #333; }
.model-name { font-size: 26rpx; color: #666; }
.record-status { padding: 8rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; font-weight: 600; }
.status-approved { background: #52c41a; color: #fff; }
.status-pending { background: #faad14; color: #fff; }

.record-info { display: flex; flex-wrap: wrap; gap: 16rpx 24rpx; margin-bottom: 12rpx; }
.info-row { display: flex; align-items: center; gap: 8rpx; }
.info-label { font-size: 24rpx; color: #999; }
.info-value { font-size: 24rpx; color: #333; }
.text-primary { color: #667eea; font-weight: 600; }

.record-footer { padding-top: 12rpx; border-top: 1rpx solid #f0f0f0; }
.time-text { font-size: 24rpx; color: #999; }

.load-more { text-align: center; padding: 32rpx; color: #fff; font-size: 28rpx; }
