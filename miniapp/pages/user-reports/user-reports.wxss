/* 报工记录 - 轻量浅色风格 */
.page-container {
  min-height: 100vh;
  background: #F5F7FB;
  padding: 0 24rpx 48rpx;
}

.top-nav {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  background: #F5F7FB;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.nav-actions {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #E8ECFF;
  color: #304FFE;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(91, 123, 255, 0.18);
}
.nav-btn-text { color: inherit; }

.main-content { padding-top: 8rpx; display: flex; flex-direction: column; gap: 20rpx; }

.stats-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.08);
}
.stats-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.stats-title { font-size: 30rpx; font-weight: 700; color: #111827; }
.stats-count { font-size: 24rpx; color: #6B7280; }
.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.stat-item { background: #F8FAFF; border-radius: 16rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; }
.stat-content { display: flex; flex-direction: column; gap: 6rpx; }
.stat-number { font-size: 30rpx; font-weight: 700; color: #111827; }
.stat-label { font-size: 22rpx; color: #6B7280; }
.stat-icon { width: 60rpx; height: 60rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; }
.quantity-icon { background: #2D4BFF; }
.wage-icon { background: linear-gradient(135deg, #22C55E 0%, #34D399 100%); }
.pending-icon { background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%); }
.icon-text { font-size: 26rpx; }

.skeleton-list { display: flex; flex-direction: column; gap: 16rpx; }
.skeleton-card { padding: 26rpx; border-radius: 18rpx; background: #FFFFFF; box-shadow: 0 6rpx 20rpx rgba(15,23,42,0.05); }
.skeleton-title { height: 32rpx; width: 60%; }
.skeleton-row { height: 28rpx; margin-top: 16rpx; }
.skeleton-row.short { width: 40%; }

.empty-wrap { text-align: center; padding: 80rpx 20rpx; background: #FFFFFF; border-radius: 18rpx; box-shadow: 0 6rpx 20rpx rgba(15,23,42,0.05); }
.empty-icon { font-size: 72rpx; margin-bottom: 18rpx; }
.empty-title { display: block; font-size: 30rpx; color: #111827; font-weight: 700; margin-bottom: 8rpx; }
.empty-desc { display: block; font-size: 24rpx; color: #6B7280; margin-bottom: 20rpx; }
.empty-action { display: inline-flex; padding: 16rpx 32rpx; background: #E8ECFF; border-radius: 999rpx; color: #304FFE; font-size: 26rpx; font-weight: 600; }
.action-text { color: inherit; }

.records-list { display: flex; flex-direction: column; gap: 18rpx; }
.record-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 26rpx;
  box-shadow: 0 8rpx 26rpx rgba(15, 23, 42, 0.08);
  border: 1rpx solid #EEF2FF;
}
.record-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.record-title { flex: 1; margin-right: 16rpx; display: flex; flex-wrap: wrap; gap: 6rpx; align-items: baseline; }
.product-name { font-size: 30rpx; font-weight: 700; color: #111827; }
.model-name { font-size: 26rpx; color: #6B7280; }
.record-status { padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 600; }
.status-0 { background: #F59E0B; color: #fff; }
.status-1 { background: #22C55E; color: #fff; }
.status-2 { background: #EF4444; color: #fff; }

.record-info { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; margin-bottom: 12rpx; }
.info-row { display: flex; align-items: center; gap: 8rpx; }
.info-label { font-size: 24rpx; color: #6B7280; }
.info-value { font-size: 24rpx; color: #111827; }
.text-primary { color: #5B7BFF; font-weight: 600; }

.record-footer { padding-top: 12rpx; border-top: 1rpx solid #E5E7EB; }
.time-text { font-size: 24rpx; color: #6B7280; }

.load-more { text-align: center; padding: 28rpx; color: #304FFE; font-size: 26rpx; }
