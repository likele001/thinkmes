<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">{{id ? '编辑工价' : '新增工价'}}</text>
  </view>
  <view class="card">
    <view class="form-item"><text class="form-label">型号ID</text><input class="form-input" type="number" placeholder="型号ID" value="{{model_id}}" bindinput="inputModelId"/></view>
    <view class="form-item"><text class="form-label">工序ID</text><input class="form-input" type="number" placeholder="工序ID" value="{{process_id}}" bindinput="inputProcessId"/></view>
    <view class="form-item"><text class="form-label">单价 *</text><input class="form-input" type="digit" placeholder="单价" value="{{price}}" bindinput="inputPrice"/></view>
    <view class="form-item"><text class="form-label">时价</text><input class="form-input" type="digit" placeholder="时价（可选）" value="{{time_price}}" bindinput="inputTimePrice"/></view>
  </view>
  <button class="btn-primary btn-block" loading="{{loading}}" bindtap="submit">{{id ? '保存' : '添加'}}</button>
</view>
