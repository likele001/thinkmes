<view class="container">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">产品型号 *</text>
      <view class="picker" bindtap="openModelSelect">{{modelLabel}}</view>
    </view>
    <view class="form-item">
      <text class="form-label">工序 *</text>
      <picker mode="selector" range="{{processOptions}}" range-key="name" value="{{processIndex}}" bindchange="pickProcess">
        <view class="picker">{{processLabel}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">计件工价</text>
      <input class="form-input" type="digit" placeholder="计件工价" value="{{price}}" bindinput="inputPrice"/>
    </view>
    <view class="form-item">
      <text class="form-label">计时工价</text>
      <input class="form-input" type="digit" placeholder="计时工价" value="{{timePrice}}" bindinput="inputTimePrice"/>
    </view>
    <view class="form-item">
      <text class="form-label">状态</text>
      <picker mode="selector" range="{{statusList}}" range-key="text" value="{{statusIndex}}" bindchange="pickStatus">
        <view class="picker">{{statusText}}</view>
      </picker>
    </view>
  </view>
  <button class="btn-submit" loading="{{loading}}" bindtap="submit">{{id ? '保存' : '添加'}}</button>
</view>
