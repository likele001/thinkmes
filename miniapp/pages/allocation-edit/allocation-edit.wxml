<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">{{id ? '编辑分工' : '新增分工'}}</text>
  </view>
  <view class="card">
    <view class="form-item">
      <text class="form-label">关联订单 *</text>
      <picker mode="selector" range="{{orderOptions}}" range-key="label" value="{{orderIndex}}" bindchange="pickOrder">
        <view class="picker">{{orderLabel}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">产品 *</text>
      <picker mode="selector" range="{{productOptions}}" range-key="label" value="{{productIndex}}" bindchange="pickProduct">
        <view class="picker">{{productLabel}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">型号 *</text>
      <view class="picker" bindtap="openModelSelect">{{modelLabel}}</view>
    </view>
    <view class="form-item">
      <text class="form-label">工序 *</text>
      <picker mode="selector" range="{{processOptions}}" range-key="name" value="{{processIndex}}" bindchange="pickProcess">
        <view class="picker">{{processLabel}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">分配员工 *</text>
      <picker mode="selector" range="{{userOptions}}" range-key="label" value="{{userIndex}}" bindchange="pickUser">
        <view class="picker">{{userLabel}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">分配数量 *</text>
      <input class="form-input" type="number" placeholder="分配数量" value="{{quantity}}" bindinput="inputQuantity"/>
    </view>
    <view class="form-item">
      <text class="form-label">状态</text>
      <picker mode="selector" range="{{statusList}}" range-key="text" value="{{statusIndex}}" bindchange="pickStatus">
        <view class="picker">{{statusText}}</view>
      </picker>
    </view>
  </view>
  <button class="btn-primary btn-block" loading="{{loading}}" bindtap="submit">{{id ? '保存' : '添加'}}</button>
</view>
