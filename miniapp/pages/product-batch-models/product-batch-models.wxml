<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">产品型号</text>
  </view>
  <view class="btn-bar-admin">
    <button class="btn-primary" bindtap="goAdd">批量添加型号</button>
  </view>
  <view class="list-item" wx:for="{{list}}" wx:key="id">
    <view class="row"><text class="title">{{item.name || item.model_name || item.model_code}}</text></view>
    <view class="text-muted">{{item.description || ''}} 产品ID: {{item.product_id}}</view>
    <view class="btn-wrap">
      <button data-id="{{item.id}}" catchtap="goEdit">编辑</button>
      <button data-id="{{item.id}}" catchtap="goPrices">工价</button>
      <button type="warn" data-id="{{item.id}}" catchtap="confirmDelete">删除</button>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && list.length===0}}">暂无型号，请先添加</view>
  <view class="no-more" wx:if="{{noMore && list.length>0}}">没有更多了</view>
</view>
