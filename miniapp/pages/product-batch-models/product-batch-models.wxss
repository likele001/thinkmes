.tip { padding: 24rpx 32rpx; background: #f0f9ff; color: #0369a1; font-size: 26rpx; }
.strong { font-weight: bold; }
.form-item { margin-bottom: 24rpx; }
.form-label { display: block; color: #666; margin-bottom: 12rpx; font-size: 28rpx; }
.form-input { border: 2rpx solid #e5e7eb; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; }
.picker { border: 2rpx solid #e5e7eb; border-radius: 12rpx; padding: 20rpx; color: #333; }
.row-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.row-title { font-weight: bold; color: #333; }
.btn-remove { color: #ef4444; font-size: 26rpx; }
.price-list { border: 2rpx solid #e5e7eb; border-radius: 12rpx; overflow: hidden; }
.price-row { display: flex; align-items: center; padding: 16rpx; border-bottom: 2rpx solid #f3f4f6; }
.price-row:last-child { border-bottom: none; }
.price-name { width: 140rpx; flex-shrink: 0; font-size: 26rpx; color: #666; }
.price-input { flex: 1; border: 2rpx solid #e5e7eb; border-radius: 8rpx; padding: 12rpx 16rpx; margin-left: 12rpx; font-size: 26rpx; }
.btn-add-row { padding: 24rpx; text-align: center; color: #4f46e5; border: 2rpx dashed #a5b4fc; border-radius: 12rpx; }
.page-with-footer { padding-bottom: 140rpx; }
.footer-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 24rpx 32rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.06); z-index: 10; }
.safe-area-bottom { padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }
.btn-primary { background: var(--primary, #4f46e5); color: #fff; border-radius: 12rpx; }
.btn-block { width: 100%; display: block; }
