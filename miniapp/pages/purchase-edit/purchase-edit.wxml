<view class="container">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">物料 *</text>
      <picker mode="selector" range="{{materialOptions}}" range-key="label" value="{{materialIndex}}" bindchange="pickMaterial">
        <view class="picker">{{materialLabel}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">入库数量 *</text>
      <input class="form-input" type="digit" placeholder="入库数量" value="{{in_quantity}}" bindinput="inputInQuantity"/>
    </view>
    <view class="form-item">
      <text class="form-label">入库时间</text>
      <picker mode="date" value="{{in_time_date}}" bindchange="pickInTime">
        <view class="picker">{{in_time_date || '选择日期'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">入库单号</text>
      <input class="form-input" placeholder="留空自动生成" value="{{in_no}}" bindinput="inputInNo"/>
    </view>
    <view class="form-item">
      <text class="form-label">供应商</text>
      <picker mode="selector" range="{{supplierOptions}}" range-key="label" value="{{supplierIndex}}" bindchange="pickSupplier">
        <view class="picker">{{supplierLabel}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">仓库</text>
      <picker mode="selector" range="{{warehouseOptions}}" range-key="name" value="{{warehouseIndex}}" bindchange="pickWarehouse">
        <view class="picker">{{warehouseLabel}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">备注</text>
      <input class="form-input" placeholder="备注" value="{{remark}}" bindinput="inputRemark"/>
    </view>
  </view>
  <button class="btn-submit" loading="{{loading}}" bindtap="submit">{{id ? '保存' : '添加'}}</button>
</view>
