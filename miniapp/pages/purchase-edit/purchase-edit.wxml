<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">{{id ? '编辑采购' : '新增采购'}}</text>
  </view>
  <view class="card">
    <view class="form-item"><text class="form-label">采购单号</text><input class="form-input" placeholder="单号" value="{{purchase_no}}" bindinput="inputNo"/></view>
    <view class="form-item"><text class="form-label">供应商ID *</text><input class="form-input" type="number" placeholder="供应商ID" value="{{supplier_id}}" bindinput="inputSupplierId"/></view>
    <view class="form-item"><text class="form-label">备注</text><input class="form-input" placeholder="备注" value="{{remark}}" bindinput="inputRemark"/></view>
  </view>
  <button class="btn-primary btn-block" loading="{{loading}}" bindtap="submit">{{id ? '保存' : '添加'}}</button>
</view>
