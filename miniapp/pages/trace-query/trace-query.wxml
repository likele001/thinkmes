<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">查询追溯</text>
  </view>
  <view class="card">
    <view class="form-item"><text class="form-label">追溯码</text><input class="form-input" placeholder="输入追溯码" value="{{code}}" bindinput="inputCode"/></view>
    <button class="btn-primary btn-block" loading="{{loading}}" bindtap="query">查询</button>
  </view>
  <view class="card" wx:if="{{result}}">
    <view class="card-title">查询结果</view>
    <view class="info-row" wx:for="{{resultRows}}" wx:key="label"><text class="label">{{item.label}}：</text><text class="value">{{item.value}}</text></view>
  </view>
</view>
