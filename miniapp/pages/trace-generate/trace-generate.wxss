.container { padding: 20rpx; }
.card { padding: 24rpx; margin-bottom: 20rpx; background: #fff; border-radius: 8rpx; }
.card-title { font-weight: bold; margin-bottom: 16rpx; }
.form-item { margin-bottom: 24rpx; }
.label { display: block; color: #666; margin-bottom: 8rpx; }
.input { border: 1rpx solid #eee; padding: 20rpx; border-radius: 8rpx; }
.btn-primary { margin-top: 16rpx; background: #4f46e5; color: #fff; }
.result .row { padding: 12rpx 0; border-bottom: 1rpx solid #eee; }
.result .value { word-break: break-all; }
.result .value.small { font-size: 24rpx; }
