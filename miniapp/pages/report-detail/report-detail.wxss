.row { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #eee; }
.row .label { color: #666; }
.status-1 { color: #10b981; }
.status-2 { color: #ef4444; }
.section-title { font-weight: bold; margin-bottom: 20rpx; }
.img-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.thumb { width: 160rpx; height: 160rpx; border-radius: 12rpx; }
.video-list { display: flex; flex-direction: column; gap: 24rpx; }
.video-item { width: 100%; height: 360rpx; border-radius: 12rpx; background: #000; }
.btn-row { margin-top: 32rpx; display: flex; gap: 24rpx; }
.btn-danger { background: #ef4444; color: #fff; border-radius: 12rpx; flex: 1; }
