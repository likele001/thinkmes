/* 报工详情 - adminweixin 风格 */
.loading-tip { padding: 24px; text-align: center; color: #999; }
.image-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.thumb { width: 80px; height: 80px; border-radius: 8px; background: #f0f0f0; }
.video-list { display: flex; flex-direction: column; gap: 16px; margin-top: 8px; }
.video-item { width: 100%; height: 200px; border-radius: 8px; background: #000; }
/* 状态标签：深色背景 + 白字，保证可读 */
.status-0 { background: #faad14; color: #fff !important; padding: 4px 12px; border-radius: 6px; font-weight: 600; display: inline-block; }
.status-1 { background: #52c41a; color: #fff !important; padding: 4px 12px; border-radius: 6px; font-weight: 600; display: inline-block; }
.status-2 { background: #ff4d4f; color: #fff !important; padding: 4px 12px; border-radius: 6px; font-weight: 600; display: inline-block; }
