/* 我的工资 - 轻量浅色风格 */
.page-container {
  min-height: 100vh;
  background: #F5F7FB;
  padding: 0 24rpx 48rpx;
}

.top-nav {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  background: #F5F7FB;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.nav-actions {
  display: flex;
  gap: 16rpx;
}
.nav-btn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(91, 123, 255, 0.18);
}
.nav-btn.btn-primary {
  background: #2D4BFF;
  color: #fff;
  font-weight: 600;
}
.nav-btn.btn-ghost {
  background: #E8ECFF;
  color: #304FFE;
}
.nav-btn-label { color: inherit; }

.main-content { padding-top: 8rpx; display: flex; flex-direction: column; gap: 20rpx; }

.filter-bar {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.08);
}
.filter-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.filter-row:last-of-type { margin-bottom: 0; }
.filter-label { width: 140rpx; flex-shrink: 0; font-size: 26rpx; color: #6B7280; font-weight: 600; }
.filter-value {
  flex: 1;
  padding: 18rpx 22rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #111827;
}
.filter-value.small { flex: none; min-width: 160rpx; }
.filter-range { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.range-sep { font-size: 24rpx; color: #9CA3AF; }
.filter-input {
  flex: 1;
  padding: 18rpx 22rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: none;
}
.filter-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.filter-actions .btn { flex: 1; }

.wage-overview {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.08);
}
.overview-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.overview-title { font-size: 30rpx; font-weight: 700; color: #111827; }
.overview-period { font-size: 24rpx; color: #6B7280; }
.overview-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.overview-item {
  text-align: center;
  padding: 24rpx;
  background: #F8FAFF;
  border-radius: 16rpx;
}
.overview-number { display: block; font-size: 34rpx; font-weight: 700; color: #5B7BFF; margin-bottom: 8rpx; }
.overview-label { font-size: 24rpx; color: #6B7280; }

.skeleton-list { display: flex; flex-direction: column; gap: 18rpx; }
.skeleton-card { padding: 26rpx; border-radius: 18rpx; background: #FFFFFF; box-shadow: 0 6rpx 20rpx rgba(15,23,42,0.05); }
.skeleton-title { height: 32rpx; width: 60%; }
.skeleton-row { height: 28rpx; margin-top: 16rpx; }
.skeleton-row.short { width: 40%; }

.empty-wrap { text-align: center; padding: 80rpx 20rpx; background: #FFFFFF; border-radius: 18rpx; box-shadow: 0 6rpx 20rpx rgba(15,23,42,0.05); }
.empty-icon { font-size: 72rpx; margin-bottom: 18rpx; }
.empty-title { display: block; font-size: 30rpx; color: #111827; font-weight: 700; margin-bottom: 8rpx; }
.empty-desc { display: block; font-size: 24rpx; color: #6B7280; margin-bottom: 20rpx; }
.empty-action { display: inline-flex; padding: 16rpx 32rpx; background: #E8ECFF; border-radius: 999rpx; color: #304FFE; font-size: 26rpx; font-weight: 600; }
.action-text { color: inherit; }

.wage-list { display: flex; flex-direction: column; gap: 18rpx; }
.wage-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 26rpx;
  box-shadow: 0 8rpx 26rpx rgba(15, 23, 42, 0.08);
  border: 1rpx solid #EEF2FF;
}
.wage-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.wage-title { flex: 1; margin-right: 16rpx; display: flex; flex-wrap: wrap; gap: 6rpx; align-items: baseline; }
.product-name { font-size: 30rpx; font-weight: 700; color: #111827; }
.model-name { font-size: 26rpx; color: #6B7280; }
.wage-amount { flex-shrink: 0; }
.amount-text { font-size: 32rpx; font-weight: 700; color: #22C55E; }

.wage-info { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; margin-bottom: 12rpx; }
.info-row { display: flex; align-items: center; gap: 8rpx; }
.info-label { font-size: 24rpx; color: #6B7280; }
.info-value { font-size: 24rpx; color: #111827; }

.wage-footer { padding-top: 12rpx; border-top: 1rpx solid #E5E7EB; }
.time-text { font-size: 24rpx; color: #9CA3AF; }

.load-more { text-align: center; padding: 28rpx; color: #304FFE; font-size: 26rpx; }
