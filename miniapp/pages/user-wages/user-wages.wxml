<view class="page-container">
  <view class="top-nav">
    <view class="nav-content">
      <text class="nav-title">我的工资</text>
      <view class="nav-actions">
        <view class="nav-btn nav-btn-text" bindtap="toggleFilter">
          <text class="nav-btn-label">筛选</text>
        </view>
        <view class="nav-btn nav-btn-icon" bindtap="refresh">
          <text class="nav-icon">↻</text>
        </view>
      </view>
    </view>
  </view>

  <view class="main-content">
    <!-- 筛选区 -->
    <view class="filter-bar" wx:if="{{filterExpanded}}">
      <view class="filter-row">
        <text class="filter-label">按月份</text>
        <picker mode="date" value="{{selectedMonth ? selectedMonth + '-01' : '2026-01-01'}}" start="2020-01-01" end="2030-12-31" bindchange="onMonthChange">
          <view class="filter-value">{{selectedMonth || '选择月份'}}</view>
        </picker>
      </view>
      <view class="filter-row">
        <text class="filter-label">按单日</text>
        <picker mode="date" value="{{workDate}}" start="2020-01-01" end="2030-12-31" bindchange="onWorkDateChange">
          <view class="filter-value">{{workDate || '选某一天'}}</view>
        </picker>
      </view>
      <view class="filter-row">
        <text class="filter-label">日期范围</text>
        <view class="filter-range">
          <picker mode="date" value="{{startDate}}" start="2020-01-01" end="2030-12-31" bindchange="onStartDateChange">
            <view class="filter-value small">{{startDate || '开始'}}</view>
          </picker>
          <text class="range-sep">至</text>
          <picker mode="date" value="{{endDate}}" start="2020-01-01" end="2030-12-31" bindchange="onEndDateChange">
            <view class="filter-value small">{{endDate || '结束'}}</view>
          </picker>
        </view>
      </view>
      <view class="filter-row">
        <text class="filter-label">订单号</text>
        <input class="filter-input" placeholder="输入订单号筛选" value="{{orderNo}}" bindinput="onOrderNoInput"/>
      </view>
      <view class="filter-row">
        <text class="filter-label">产品名称</text>
        <input class="filter-input" placeholder="输入产品名称筛选" value="{{productName}}" bindinput="onProductNameInput"/>
      </view>
      <view class="filter-actions">
        <button class="btn-filter" bindtap="applyFilter">查询</button>
        <button class="btn-clear" bindtap="clearFilter">清空</button>
      </view>
    </view>

    <view class="wage-overview" wx:if="{{!loading && (totalWage > 0 || wageList.length > 0)}}">
      <view class="overview-header">
        <text class="overview-title">工资概览</text>
        <text class="overview-period">{{selectedMonth || '本月'}}{{orderNo ? ' · 订单:' + orderNo : ''}}{{productName ? ' · 产品:' + productName : ''}}</text>
      </view>
      <view class="overview-stats">
        <view class="overview-item">
          <text class="overview-number">¥{{totalWage}}</text>
          <text class="overview-label">总工资</text>
        </view>
        <view class="overview-item">
          <text class="overview-number">{{totalQuantity}}</text>
          <text class="overview-label">总报工数</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-wrap">
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:elif="{{wageList.length === 0}}" class="empty-wrap">
      <view class="empty-icon">💰</view>
      <text class="empty-title">暂无工资记录</text>
      <text class="empty-desc">可切换月份、日期或按订单/产品筛选</text>
      <view class="empty-action" bindtap="refresh"><text class="action-text">刷新</text></view>
    </view>

    <view wx:else class="wage-list">
      <view wx:for="{{wageList}}" wx:key="id" class="wage-card">
        <view class="wage-header">
          <view class="wage-title">
            <text class="product-name">{{item.product_name || '产品'}}</text>
            <text class="model-name">- {{item.model_name || ''}}</text>
          </view>
          <view class="wage-amount">
            <text class="amount-text">¥{{item.wage || 0}}</text>
          </view>
        </view>
        <view class="wage-info">
          <view class="info-row">
            <text class="info-label">订单</text>
            <text class="info-value">{{item.order_no || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">工序</text>
            <text class="info-value">{{item.process_name || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">数量</text>
            <text class="info-value">{{item.quantity}}</text>
          </view>
        </view>
        <view class="wage-footer">
          <text class="time-text">🕒 {{item.createtime_text || item.createtime || ''}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!loading && hasMore && wageList.length > 0}}" class="load-more" bindtap="loadMore">
      <text>加载更多</text>
    </view>
  </view>
</view>
