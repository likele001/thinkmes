<view class="container bind-page">
  <view class="title">绑定用户中心员工</view>
  <view class="desc">请输入您在用户中心的账号和密码，绑定后可进行报工、查看任务与工资。</view>
  <view class="form-item">
    <input placeholder="用户名/工号" value="{{username}}" bindinput="inputUsername" class="input"/>
  </view>
  <view class="form-item">
    <input password placeholder="密码" value="{{password}}" bindinput="inputPassword" class="input"/>
  </view>
  <button class="btn-primary" loading="{{loading}}" bindtap="submit">绑定并登录</button>
  <view class="back-link" bindtap="backToLogin">返回登录页</view>
</view>
