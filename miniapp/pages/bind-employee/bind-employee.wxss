/* 绑定员工 - 参考 adminweixin 登录页风格 */
.bind-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}

.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  animation: float 6s ease-in-out infinite;
}

.circle-1 { width: 200rpx; height: 200rpx; top: 10%; right: 10%; animation-delay: 0s; }
.circle-2 { width: 150rpx; height: 150rpx; bottom: 20%; left: 5%; animation-delay: 2s; }
.circle-3 { width: 100rpx; height: 100rpx; top: 60%; left: 20%; animation-delay: 4s; }

@keyframes float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20rpx) rotate(180deg); }
}

.bind-form.card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  max-width: 600rpx;
  z-index: 2;
  position: relative;
}

.form-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.back-btn {
  display: flex;
  align-items: center;
  color: #667eea;
  font-size: 28rpx;
  margin-right: 24rpx;
  padding: 10rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(102, 126, 234, 0.1);
}

.back-btn:active { background: rgba(102, 126, 234, 0.2); transform: scale(0.95); }
.back-icon { font-size: 32rpx; margin-right: 8rpx; font-weight: bold; }
.form-title { font-size: 36rpx; color: #333; font-weight: 600; }
.form-desc { font-size: 26rpx; color: #666; margin-bottom: 40rpx; line-height: 1.5; }

.form-item { margin-bottom: 32rpx; }

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input-wrapper:focus-within {
  background: #fff;
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.input-icon { font-size: 32rpx; margin-right: 20rpx; color: #667eea; }
.input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
}

.btn-login {
  margin-top: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
}

.btn-login:active { transform: scale(0.98); }
