<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">{{id ? '编辑发货' : '新增发货'}}</text>
  </view>
  <view class="card">
    <view class="form-item"><text class="form-label">发货单号</text><input class="form-input" placeholder="单号" value="{{shipment_no}}" bindinput="inputNo"/></view>
    <view class="form-item"><text class="form-label">客户ID *</text><input class="form-input" type="number" placeholder="客户ID" value="{{customer_id}}" bindinput="inputCustomerId"/></view>
    <view class="form-item"><text class="form-label">备注</text><input class="form-input" placeholder="备注" value="{{remark}}" bindinput="inputRemark"/></view>
  </view>
  <button class="btn-primary btn-block" loading="{{loading}}" bindtap="submit">{{id ? '保存' : '添加'}}</button>
</view>
