<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">工价管理</text>
  </view>
  <view class="btn-bar-admin" wx:if="{{!processId}}">
    <button class="btn-primary" bindtap="goAdd">新增工价</button>
  </view>
  <view class="list-item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}">
    <view class="row"><text class="title">{{item.model_name || item.product_model || '型号'}} - {{item.process_name || '工序'}}</text></view>
    <view class="text-muted">单价 ¥{{item.price || 0}} <text wx:if="{{item.time_price}}">时价 ¥{{item.time_price}}</text></view>
    <view class="btn-wrap">
      <button data-id="{{item.id}}" catchtap="goEdit">编辑</button>
      <button type="warn" data-id="{{item.id}}" catchtap="confirmDelete">删除</button>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && list.length===0}}">暂无工价</view>
  <view class="no-more" wx:if="{{noMore && list.length>0}}">没有更多了</view>
</view>
