<view class="container">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">关联订单 *</text>
      <picker mode="selector" range="{{orderOptions}}" range-key="label" value="{{orderIndex}}" bindchange="pickOrder">
        <view class="picker">{{orderLabel}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">售后类型</text>
      <picker mode="selector" range="{{typeList}}" range-key="text" value="{{typeIndex}}" bindchange="pickType">
        <view class="picker">{{typeText}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">状态</text>
      <picker mode="selector" range="{{statusList}}" range-key="text" value="{{statusIndex}}" bindchange="pickStatus">
        <view class="picker">{{statusText}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">售后内容/备注</text>
      <textarea class="form-textarea" placeholder="售后内容或备注" value="{{content}}" bindinput="inputContent"/>
    </view>
  </view>
  <button class="btn-submit" loading="{{loading}}" bindtap="submit">{{id ? '保存' : '添加'}}</button>
</view>
