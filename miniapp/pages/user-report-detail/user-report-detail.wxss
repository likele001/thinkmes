/* 报工详情 - 与 report-detail（adminweixin）一致 */
.page-container, .container { min-height: 100vh; background: #f5f5f5; padding-bottom: 32rpx; }
.admin-page .page-header-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}
.page-back { font-size: 32rpx; margin-right: 24rpx; }
.page-title { font-size: 34rpx; font-weight: 600; }
.loading-tip { padding: 48rpx; text-align: center; color: #999; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.card-title { font-size: 30rpx; font-weight: 700; color: #333; margin-bottom: 20rpx; }
.info-row, .row { display: flex; padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.info-row:last-child, .row:last-child { border-bottom: none; }
.label { width: 160rpx; flex-shrink: 0; font-size: 26rpx; color: #666; }
.value { flex: 1; font-size: 26rpx; color: #333; }
.status-0 { background: #faad14; color: #fff; padding: 4rpx 16rpx; border-radius: 8rpx; font-weight: 600; }
.status-1 { background: #52c41a; color: #fff; padding: 4rpx 16rpx; border-radius: 8rpx; font-weight: 600; }
.status-2 { background: #ff4d4f; color: #fff; padding: 4rpx 16rpx; border-radius: 8rpx; font-weight: 600; }
.image-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; }
.thumb { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #f0f0f0; }
.video-list { display: flex; flex-direction: column; gap: 24rpx; margin-top: 12rpx; }
.video-item { width: 100%; height: 360rpx; border-radius: 12rpx; background: #000; }
.empty { padding: 80rpx; text-align: center; color: #999; font-size: 28rpx; }
