.page-container{min-height:100vh;background:#f6f7fb}
.top-nav{padding:16px;background:#fff;border-bottom:1px solid #eee}
.nav-title{font-size:18px;font-weight:600}
.main-content{padding:12px}
.toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.tabs{display:flex;gap:8px}
.tab{padding:6px 10px;border-radius:12px;background:#eee;color:#333;font-size:12px}
.tab.active{background:#3cc51f;color:#fff}
.btn{background:#fff;border:1px solid #ddd}
.card{background:#fff;border-radius:8px;padding:12px;margin-bottom:10px}
.row{display:flex;align-items:center;justify-content:space-between}
.title{font-size:15px;font-weight:600}
.badge{font-size:12px;padding:2px 6px;border-radius:10px}
.badge.unread{background:#ffe9e9;color:#d93025}
.badge.read{background:#e9f6ee;color:#137333}
.content{margin-top:8px;color:#444;font-size:13px;white-space:pre-wrap}
.time{margin-top:8px;color:#888;font-size:12px}
.empty,.loading{text-align:center;color:#888;margin-top:20px}
.load-more{margin-top:10px}
