<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goIndex">← 首页</view>
    <text class="page-title">生产计划</text>
  </view>
  <view class="btn-bar-admin">
    <button class="btn-primary" bindtap="goAdd">新建计划</button>
  </view>
  <view class="list-item plan-item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}">
    <view class="row"><text class="title">{{item.plan_name || item.plan_code || '计划'}}</text><text class="status-{{item.status}}">{{item.status_text || (item.status == 0 ? '未开始' : item.status == 1 ? '进行中' : '已完成')}}</text></view>
    <view class="text-muted">产品：{{item.product_name || '-'}} {{item.product_model || ''}} 数量：{{item.total_quantity || 0}} 完成：{{item.actual_quantity || 0}}</view>
    <view class="btn-wrap">
      <button data-id="{{item.id}}" catchtap="goDetail">详情</button>
      <button data-id="{{item.id}}" catchtap="goEdit">编辑</button>
      <button data-id="{{item.id}}" catchtap="goProgress">进度</button>
      <button data-id="{{item.id}}" catchtap="goAllocations">分工</button>
      <button type="warn" data-id="{{item.id}}" catchtap="confirmDelete">删除</button>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && list.length===0}}">暂无生产计划</view>
  <view class="no-more" wx:if="{{noMore && list.length>0}}">没有更多了</view>
</view>
