<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">{{id ? '编辑计划' : '新建计划'}}</text>
  </view>
  <view class="card">
    <view class="form-item"><text class="form-label">计划名称 *</text><input class="form-input" placeholder="计划名称" value="{{plan_name}}" bindinput="inputName"/></view>
    <view class="form-item"><text class="form-label">计划编码</text><input class="form-input" placeholder="计划编码" value="{{plan_code}}" bindinput="inputCode"/></view>
    <view class="form-item"><text class="form-label">订单ID</text><input class="form-input" type="number" placeholder="订单ID" value="{{order_id}}" bindinput="inputOrderId"/></view>
    <view class="form-item"><text class="form-label">产品型号ID *</text><input class="form-input" type="number" placeholder="产品型号ID" value="{{model_id}}" bindinput="inputModelId"/></view>
    <view class="form-item"><text class="form-label">计划数量 *</text><input class="form-input" type="number" placeholder="计划数量" value="{{total_quantity}}" bindinput="inputQuantity"/></view>
  </view>
  <button class="btn-primary btn-block" loading="{{loading}}" bindtap="submit">{{id ? '保存' : '创建'}}</button>
</view>
