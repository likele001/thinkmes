<view class="page-container">
  <view class="top-nav">
    <view class="nav-content">
      <view class="nav-title">任务报工</view>
      <view class="nav-actions">
        <view class="nav-btn" bindtap="goBack">
          <text class="nav-icon">←</text>
        </view>
      </view>
    </view>
  </view>

  <view class="main-content">
    <view wx:if="{{loading}}" class="loading-wrap">
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:elif="{{task.allocation_id}}" class="task-detail">
      <view class="task-card">
        <view class="task-header">
          <text class="task-title">{{task.product_name}} - {{task.model_name}}</text>
          <view class="task-status status-pending" wx:if="{{task.pending_qty > 0}}">
            <text class="task-status-text">待报 {{task.pending_qty}}</text>
          </view>
          <view class="task-status status-success" wx:else>
            <text class="task-status-text">已报满</text>
          </view>
        </view>
        <view class="task-info">
          <text class="info-text">{{task.order_name || task.order_no}} · {{task.process_name}}</text>
          <text class="info-text">已报 {{task.reported_qty}} / 分配 {{task.assign_qty}}</text>
        </view>
      </view>

      <view class="form-card" wx:if="{{task.pending_qty > 0}}">
        <view class="form-title">报工数量</view>
        <view class="form-item">
          <view class="input-wrapper">
            <text class="input-icon">📋</text>
            <input type="number" placeholder="请输入数量（1~{{task.pending_qty}}）" value="{{quantity}}" bindinput="inputQuantity" class="input"/>
          </view>
        </view>
        <button class="btn-submit" loading="{{submitting}}" bindtap="submit">提交报工</button>
      </view>

      <view wx:else class="empty-tip">该任务已报满，无需再报</view>
    </view>

    <view wx:else class="empty-wrap">
      <text class="empty-title">任务不存在或无权操作</text>
      <view class="back-link" bindtap="goBack">返回</view>
    </view>
  </view>
</view>
