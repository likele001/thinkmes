/* 任务报工 - adminweixin 风格 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  padding-bottom: 40rpx;
}

.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  padding: 20rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.nav-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea, #764ba2);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.nav-actions { display: flex; align-items: center; }
.nav-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}
.nav-btn:active { transform: scale(0.95); }
.nav-icon { font-size: 32rpx; color: #fff; }

.main-content { padding-top: 120rpx; padding-left: 40rpx; padding-right: 40rpx; position: relative; z-index: 1; }

.loading-wrap { text-align: center; padding: 60rpx; color: #fff; font-size: 28rpx; }

.task-detail { display: flex; flex-direction: column; gap: 30rpx; }
.task-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.task-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.task-title { font-size: 30rpx; font-weight: 700; color: #333; flex: 1; margin-right: 16rpx; }
.task-status { padding: 8rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; }
.task-status.status-pending { background: #faad14; color: #fff; }
.task-status.status-success { background: #52c41a; color: #fff; }
.task-status-text { font-weight: 600; }
.task-info { display: flex; flex-direction: column; gap: 8rpx; }
.info-text { font-size: 24rpx; color: #666; }

.form-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.form-title { font-size: 32rpx; font-weight: 700; color: #333; margin-bottom: 24rpx; }
.form-item { margin-bottom: 24rpx; }
.input-wrapper {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid transparent;
}
.input-wrapper:focus-within { background: #fff; border-color: #667eea; }
.input-icon { font-size: 32rpx; margin-right: 20rpx; color: #667eea; }
.input { flex: 1; height: 88rpx; font-size: 28rpx; color: #333; }

.btn-submit {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
}
.btn-submit:active { transform: scale(0.98); }

.empty-tip { text-align: center; padding: 48rpx; color: #fff; font-size: 28rpx; }
.empty-wrap { text-align: center; padding: 80rpx 40rpx; }
.empty-title { display: block; font-size: 32rpx; color: #fff; margin-bottom: 32rpx; }
.back-link { color: rgba(255,255,255,0.9); font-size: 28rpx; text-decoration: underline; }
