<view class="container" wx:if="{{detail}}">
  <view class="card">
    <view class="row"><text class="label">订单</text><text>{{detail.order_no || detail.order_name}}</text></view>
    <view class="row"><text class="label">产品/型号</text><text>{{detail.product_name}} / {{detail.model_name}}</text></view>
    <view class="row"><text class="label">工序</text><text>{{detail.process_name}}</text></view>
    <view class="row"><text class="label">数量</text><text>{{detail.quantity}}</text></view>
    <view class="row"><text class="label">分配给</text><text>{{detail.assignee_name || '未分配'}}</text></view>
    <view class="row"><text class="label">状态</text><text>{{detail.status_text || detail.status}}</text></view>
  </view>
  <view class="btn-row">
    <button size="mini" bindtap="goEdit">编辑</button>
    <button size="mini" class="btn-qrcode" bindtap="generateQrcode">生成二维码</button>
    <button size="mini" type="warn" bindtap="confirmDelete">删除</button>
  </view>
</view>
<view class="container" wx:elif="{{!loading}}">暂无数据</view>
<view class="container" wx:else>加载中...</view>
