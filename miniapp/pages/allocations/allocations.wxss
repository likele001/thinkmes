.btn-bar { padding: 20rpx; }
.btn-add { background: #1989fa; color: #fff; font-size: 28rpx; }
.row { display: flex; justify-content: space-between; }
.title { font-weight: bold; margin-bottom: 8rpx; }
.card { padding: 24rpx; margin: 20rpx; background: #fff; border-radius: 8rpx; }
.btn-wrap { margin-top: 16rpx; display: flex; gap: 16rpx; }
.text-muted { font-size: 26rpx; color: #666; margin-top: 8rpx; }
.empty, .no-more { text-align: center; color: #999; padding: 32rpx; }
