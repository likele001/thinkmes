<view class="container">
  <view class="btn-bar"><button class="btn-add" bindtap="goAdd">新增分工</button></view>
  <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}">
    <view class="row" bindtap="goDetail" data-id="{{item.id}}">
      <text class="title">{{item.model && item.model.product ? item.model.product.name : ''}} - {{item.model ? item.model.name : ''}}</text>
    </view>
    <view class="text-muted">订单：{{item.order && item.order.order_name ? item.order.order_name : item.order_no}}</view>
    <view class="text-muted">工序：{{item.process ? item.process.name : ''}} · 数量 {{item.quantity}}</view>
    <view class="btn-wrap">
      <button size="mini" data-id="{{item.id}}" catchtap="goDetail">详情</button>
      <button size="mini" data-id="{{item.id}}" catchtap="goEdit">编辑</button>
      <button size="mini" type="warn" data-id="{{item.id}}" catchtap="confirmDelete">删除</button>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && list.length===0}}">暂无分工</view>
  <view class="no-more" wx:if="{{noMore && list.length>0}}">没有更多了</view>
</view>
