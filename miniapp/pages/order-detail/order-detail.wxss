.card { padding: 24rpx; margin-bottom: 24rpx; background: #fff; border-radius: 16rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.card-title { font-size: 30rpx; font-weight: 700; color: #1e293b; margin-bottom: 20rpx; padding-bottom: 12rpx; border-bottom: 2rpx solid #eee; }
.row { display: flex; justify-content: space-between; padding: 12rpx 0; }
.label { color: #64748b; font-size: 26rpx; }
.status-0 { color: #94a3b8; }
.status-1 { color: #4f46e5; }
.status-2 { color: #10b981; }
.status-3 { color: #94a3b8; }

.table-head { display: flex; padding: 12rpx 0; border-bottom: 2rpx solid #eee; font-size: 24rpx; color: #64748b; font-weight: 600; }
.table-row { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid #f1f5f9; font-size: 26rpx; }
.table-row:last-child { border-bottom: none; }
.col-product { flex: 1.2; }
.col-model { flex: 1.2; }
.col-num { flex: 0.6; text-align: center; }
.col-done { flex: 0.6; text-align: center; color: #10b981; }

.alloc-list { margin-top: 8rpx; }
.alloc-item { padding: 20rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.alloc-item:last-child { border-bottom: none; }
.alloc-item:active { background: #f8fafc; }
.alloc-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.alloc-name { font-weight: 600; font-size: 28rpx; color: #1e293b; }
.alloc-status { font-size: 24rpx; }
.alloc-meta { font-size: 24rpx; color: #64748b; }
.empty-tip { text-align: center; color: #94a3b8; padding: 32rpx; font-size: 26rpx; }

.btn-row { margin-top: 32rpx; display: flex; gap: 24rpx; }
