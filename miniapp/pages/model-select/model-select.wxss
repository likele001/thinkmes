.container { display: flex; flex-direction: column; height: 100vh; background: #fff; }
.search-bar { padding: 24rpx; border-bottom: 1rpx solid #eee; }
.search-input { width: 100%; padding: 20rpx 24rpx; background: #f5f5f5; border-radius: 12rpx; font-size: 28rpx; box-sizing: border-box; }
.list { flex: 1; height: 0; min-height: 400rpx; }
.item { padding: 28rpx 24rpx; border-bottom: 1rpx solid #f0f0f0; }
.item-label { font-size: 30rpx; color: #333; }
.empty { padding: 80rpx; text-align: center; color: #999; font-size: 28rpx; }
