<view class="container admin-index">
  <view class="header">
    <view class="welcome">欢迎使用后台管理系统</view>
    <view class="admin-info" wx:if="{{adminInfo}}">
      <text>管理员：{{adminInfo.nickname || adminInfo.username || '管理员'}}</text>
    </view>
  </view>

  <view class="menu-grid">
    <view class="menu-item" bindtap="goOrders">
      <view class="menu-icon">📋</view>
      <text class="menu-text">订单管理</text>
    </view>
    <view class="menu-item" bindtap="goCustomers">
      <view class="menu-icon">👥</view>
      <text class="menu-text">客户管理</text>
    </view>
    <view class="menu-item" bindtap="goAllocations">
      <view class="menu-icon">🔧</view>
      <text class="menu-text">分工管理</text>
    </view>
    <view class="menu-item" bindtap="goReports">
      <view class="menu-icon">✅</view>
      <text class="menu-text">报工审核</text>
    </view>
    <view class="menu-item" bindtap="goActiveReports">
      <view class="menu-icon">⚡</view>
      <text class="menu-text">待审核报工</text>
    </view>
    <view class="menu-item" bindtap="goReportStatistics">
      <view class="menu-icon">📊</view>
      <text class="menu-text">报工统计</text>
    </view>
    <view class="menu-item" bindtap="goProducts">
      <view class="menu-icon">📦</view>
      <text class="menu-text">产品/型号</text>
    </view>
    <view class="menu-item" bindtap="goProcesses">
      <view class="menu-icon">⚙️</view>
      <text class="menu-text">工序管理</text>
    </view>
    <view class="menu-item" bindtap="goProcessPrices">
      <view class="menu-icon">💰</view>
      <text class="menu-text">工序工价</text>
    </view>
    <view class="menu-item" bindtap="goMaterials">
      <view class="menu-icon">🧱</view>
      <text class="menu-text">物料</text>
    </view>
    <view class="menu-item" bindtap="goSuppliers">
      <view class="menu-icon">🏢</view>
      <text class="menu-text">供应商</text>
    </view>
    <view class="menu-item" bindtap="goWarehouses">
      <view class="menu-icon">🏭</view>
      <text class="menu-text">仓库</text>
    </view>
    <view class="menu-item" bindtap="goStock">
      <view class="menu-icon">📊</view>
      <text class="menu-text">库存</text>
    </view>
    <view class="menu-item" bindtap="goBom">
      <view class="menu-icon">📑</view>
      <text class="menu-text">BOM</text>
    </view>
    <view class="menu-item" bindtap="goPlans">
      <view class="menu-icon">📅</view>
      <text class="menu-text">生产计划</text>
    </view>
    <view class="menu-item" bindtap="goPurchases">
      <view class="menu-icon">🛒</view>
      <text class="menu-text">采购</text>
    </view>
    <view class="menu-item" bindtap="goShipments">
      <view class="menu-icon">🚚</view>
      <text class="menu-text">发货</text>
    </view>
    <view class="menu-item" bindtap="goQuality">
      <view class="menu-icon">🔍</view>
      <text class="menu-text">质检</text>
    </view>
    <view class="menu-item" bindtap="goAdminWages">
      <view class="menu-icon">💵</view>
      <text class="menu-text">工资</text>
    </view>
    <view class="menu-item" bindtap="goTrace">
      <view class="menu-icon">🔗</view>
      <text class="menu-text">追溯码</text>
    </view>
    <view class="menu-item" bindtap="goAftersales">
      <view class="menu-icon">🛠️</view>
      <text class="menu-text">售后</text>
    </view>
    <view class="menu-item" bindtap="goBi">
      <view class="menu-icon">📈</view>
      <text class="menu-text">BI看板</text>
    </view>
    <view class="menu-item" bindtap="switchToUser">
      <view class="menu-icon">👷</view>
      <text class="menu-text">切换员工端</text>
    </view>
    <view class="menu-item" bindtap="logout">
      <view class="menu-icon">🔒</view>
      <text class="menu-text">退出登录</text>
    </view>
  </view>

  <view class="stats" wx:if="{{stats}}">
    <view class="stats-title">系统统计</view>
    <view class="stats-grid">
      <view class="stats-item" bindtap="goOrders">
        <view class="stats-number">{{stats.totalOrders}}</view>
        <view class="stats-label">总订单数</view>
      </view>
      <view class="stats-item" bindtap="goAllocations">
        <view class="stats-number">{{stats.activeAllocations}}</view>
        <view class="stats-label">进行中分工</view>
      </view>
      <view class="stats-item" bindtap="goReports">
        <view class="stats-number">{{stats.pendingReports}}</view>
        <view class="stats-label">待审核报工</view>
      </view>
      <view class="stats-item" bindtap="goReportStatistics">
        <view class="stats-number">{{stats.todayQuantity}}</view>
        <view class="stats-label">今日报工量</view>
      </view>
      <view class="stats-item" bindtap="goAdminWages">
        <view class="stats-number">¥{{stats.todayWage}}</view>
        <view class="stats-label">今日工资</view>
      </view>
      <view class="stats-item" bindtap="goBi">
        <view class="stats-number">{{stats.totalPlans}}</view>
        <view class="stats-label">生产计划数</view>
      </view>
    </view>
  </view>

  <view class="card loading-card" wx:if="{{loading && !stats}}">加载中...</view>
</view>
