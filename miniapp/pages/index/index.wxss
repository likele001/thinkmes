/* 管理端首页 - 与 adminweixin 完全对齐 */
.admin-index .container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.admin-index .header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.admin-index .welcome {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.admin-index .admin-info {
  font-size: 28rpx;
  opacity: 0.9;
}

.admin-index .menu-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.admin-index .menu-item {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  padding: 40rpx 20rpx;
  border-radius: 15rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  border: 2rpx solid #f1f3f4;
}

.admin-index .menu-item:nth-child(odd) {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  border-color: #e1f5fe;
}

.admin-index .menu-item:nth-child(even) {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
  border-color: #f8bbd9;
}

.admin-index .menu-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.1);
}

.admin-index .menu-icon {
  font-size: 60rpx;
  margin-bottom: 15rpx;
  color: #4a90e2;
}

.admin-index .menu-item:nth-child(odd) .menu-icon { color: #2196f3; }
.admin-index .menu-item:nth-child(even) .menu-icon { color: #9c27b0; }

.admin-index .menu-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.admin-index .stats {
  background: #fff;
  border-radius: 15rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.admin-index .stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.admin-index .stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.admin-index .stats-item {
  text-align: center;
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 20rpx;
  border: 2rpx solid transparent;
}

.admin-index .stats-item:active {
  transform: scale(0.95);
  background: #e9ecef;
  border-color: #667eea;
}

.admin-index .stats-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 8rpx;
}

.admin-index .stats-label {
  font-size: 24rpx;
  color: #666;
}

.admin-index .loading-card {
  margin-bottom: 28rpx;
  text-align: center;
  color: #64748b;
  padding: 32rpx;
}
