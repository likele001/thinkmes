/* ========== 管理端首页 - 与员工端/PC 结构一致 ========== */
.admin-index .container {
  padding: 28rpx 24rpx 120rpx;
}

/* 欢迎区（与员工端一致） */
.admin-index .welcome-card {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(79, 70, 229, 0.3);
}

.admin-index .welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.admin-index .welcome-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 12rpx;
}

.admin-index .welcome-date {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 今日三指标（与员工端三色卡一致） */
.admin-index .stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.admin-index .stat-card {
  flex: 1;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.admin-index .stat-report {
  background: linear-gradient(145deg, #4f46e5, #6366f1);
  color: #fff;
}

.admin-index .stat-pending {
  background: linear-gradient(145deg, #ea580c, #f97316);
  color: #fff;
}

.admin-index .stat-active {
  background: linear-gradient(145deg, #059669, #10b981);
  color: #fff;
}

.admin-index .stat-num {
  font-size: 36rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 8rpx;
}

.admin-index .stat-label {
  font-size: 22rpx;
  opacity: 0.95;
}

.admin-index .loading-card {
  margin-bottom: 28rpx;
  text-align: center;
  color: #64748b;
  padding: 32rpx;
}

/* 区块标题 */
.admin-index .section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  padding: 24rpx 0 20rpx;
  margin-top: 8rpx;
}

/* 功能网格 - 两列铺满，不单列留空 */
.admin-index .menu-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20rpx 4%;
  margin-bottom: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.admin-index .menu-item {
  width: 48%;
  flex: 0 0 48%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
}

.admin-index .menu-item:active {
  transform: scale(0.98);
}

.admin-index .menu-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
  display: block;
}

.admin-index .menu-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #334155;
}

/* 快捷操作（与员工端一致） */
.admin-index .quick-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}

.admin-index .quick-btn {
  flex: 1;
  min-width: calc(33.333% - 14rpx);
  padding: 24rpx 20rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.admin-index .quick-btn.primary {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.3);
}

.admin-index .quick-btn.success {
  background: linear-gradient(135deg, #059669, #10b981);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(5, 150, 105, 0.3);
}

.admin-index .quick-btn.outline {
  background: #fff;
  color: #4f46e5;
  border: 2rpx solid #6366f1;
}
