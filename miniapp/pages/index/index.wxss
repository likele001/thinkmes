.header { margin-bottom: 32rpx; }
.welcome { font-size: 32rpx; color: #666; }
.admin-name { font-size: 36rpx; font-weight: bold; margin-top: 8rpx; }
.stats-title { margin-bottom: 16rpx; }
.stats-row { display: flex; gap: 32rpx; }
.stats-item { flex: 1; text-align: center; padding: 24rpx; background: #f8f8f8; border-radius: 12rpx; }
.stats-item .num { font-size: 40rpx; font-weight: bold; color: #1989fa; display: block; }
.stats-item .label { font-size: 24rpx; color: #999; }
.menu-grid { display: flex; flex-wrap: wrap; gap: 24rpx; }
.menu-item { width: calc(50% - 12rpx); background: #fff; border-radius: 16rpx; padding: 32rpx; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.menu-icon { font-size: 48rpx; margin-bottom: 16rpx; }
.menu-text { font-size: 28rpx; }
