<view class="container">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">工序名称 *</text>
      <input class="form-input" placeholder="工序名称" value="{{name}}" bindinput="inputName"/>
    </view>
    <view class="form-item">
      <text class="form-label">工序编码</text>
      <input class="form-input" placeholder="工序编码" value="{{code}}" bindinput="inputCode"/>
    </view>
    <view class="form-item">
      <text class="form-label">工序描述</text>
      <textarea class="form-textarea" placeholder="工序描述" value="{{description}}" bindinput="inputDescription"/>
    </view>
    <view class="form-item">
      <text class="form-label">排序</text>
      <input class="form-input" type="number" placeholder="数字越小越靠前" value="{{sort}}" bindinput="inputSort"/>
    </view>
    <view class="form-item">
      <text class="form-label">状态</text>
      <picker mode="selector" range="{{statusList}}" range-key="text" value="{{statusIndex}}" bindchange="pickStatus">
        <view class="picker">{{statusText}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">备注</text>
      <input class="form-input" placeholder="备注" value="{{remark}}" bindinput="inputRemark"/>
    </view>
  </view>
  <button class="btn-submit" loading="{{loading}}" bindtap="submit">{{id ? '保存' : '添加'}}</button>
</view>
