<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goBack">← 返回</view>
    <text class="page-title">计划进度统计</text>
  </view>
  <view class="card">
    <view class="card-title">统计</view>
    <view class="info-row" wx:for="{{statsRows}}" wx:key="label"><text class="label">{{item.label}}：</text><text class="value">{{item.value}}</text></view>
  </view>
  <view class="empty" wx:if="{{!loading && !statsRows.length}}">暂无数据</view>
</view>
