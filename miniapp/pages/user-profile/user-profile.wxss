/* 我的 - 轻量浅色风格 */
.page-container {
  min-height: 100vh;
  background: #F5F7FB;
  padding: 0 24rpx 48rpx;
}

.top-nav {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  background: #F5F7FB;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.main-content { padding-top: 8rpx; display: flex; flex-direction: column; gap: 24rpx; }

.user-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.08);
  border: 1rpx solid #EEF2FF;
}

.user-header { display: flex; align-items: center; }
.user-avatar { margin-right: 24rpx; }
.avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #2D4BFF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 123, 255, 0.25);
}
.avatar-text { font-size: 40rpx; font-weight: 700; color: #fff; }
.user-info { flex: 1; }
.user-name { display: block; font-size: 32rpx; font-weight: 700; color: #111827; margin-bottom: 8rpx; }
.user-id { display: block; font-size: 26rpx; color: #6B7280; }

.menu-sections { display: flex; flex-direction: column; gap: 24rpx; }
.menu-section {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.08);
  border: 1rpx solid #EEF2FF;
}

.section-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.section-icon { width: 40rpx; height: 40rpx; border-radius: 10rpx; }
.section-icon.blue { background: #2D4BFF; }
.section-icon.gray { background: #E5E7EB; }
.section-meta { display: flex; flex-direction: column; }
.section-title { font-size: 30rpx; font-weight: 700; color: #111827; }
.section-desc { font-size: 24rpx; color: #6B7280; }

.menu-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
  background: #F8FAFF;
  border-radius: 16rpx;
  transition: transform 120ms ease;
}
.menu-item:active { transform: scale(0.98); }
.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  background: #2D4BFF;
}
.menu-icon.blue { background: #2D4BFF; }
.menu-icon.green { background: linear-gradient(135deg, #22C55E 0%, #34D399 100%); }
.menu-icon.purple { background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%); }
.menu-icon.orange { background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%); }
.menu-icon.red { background: linear-gradient(135deg, #EF4444 0%, #F87171 100%); }
.menu-text { font-size: 24rpx; color: #374151; font-weight: 600; text-align: center; }
