/* 我的 - adminweixin 风格，与 user-index 一致 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  padding-bottom: 40rpx;
  position: relative;
}

.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
  padding: 20rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.nav-content { display: flex; justify-content: space-between; align-items: center; padding: 0 40rpx; }
.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea, #764ba2);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.main-content { padding-top: 120rpx; padding-left: 40rpx; padding-right: 40rpx; position: relative; z-index: 1; }

.user-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.user-header { display: flex; align-items: center; }
.user-avatar { margin-right: 28rpx; }
.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}
.avatar-text { font-size: 40rpx; font-weight: 700; color: #fff; }
.user-info { flex: 1; }
.user-name { display: block; font-size: 34rpx; font-weight: 700; color: #333; margin-bottom: 8rpx; }
.user-id { display: block; font-size: 26rpx; color: #666; }

.menu-sections { display: flex; flex-direction: column; gap: 30rpx; }
.menu-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.section-header { margin-bottom: 24rpx; }
.section-title { display: block; font-size: 32rpx; font-weight: 700; color: #333; margin-bottom: 8rpx; }
.section-desc { display: block; font-size: 24rpx; color: #666; }

.menu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 20rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}
.menu-item:active { transform: scale(0.98); }
.menu-icon { font-size: 48rpx; margin-bottom: 16rpx; }
.menu-text { font-size: 26rpx; color: #333; font-weight: 600; text-align: center; }
