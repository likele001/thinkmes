<view class="container admin-page">
  <view class="page-header-bar">
    <view class="page-back" bindtap="goIndex">← 首页</view>
    <text class="page-title">工序管理</text>
  </view>
  <view class="btn-bar-admin">
    <button class="btn-primary" bindtap="goAdd">新增工序</button>
  </view>
  <view class="filter-bar">
    <picker bindchange="onStatusChange" value="{{statusIndex}}" range="{{statusList}}">
      <view class="picker">{{statusList[statusIndex]}}</view>
    </picker>
  </view>
  <view class="list-item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}">
    <view class="row"><text class="title">{{item.name || '-'}}</text><text class="status-{{item.status}}">{{item.status == 1 ? '启用' : '禁用'}}</text></view>
    <view class="text-muted">{{item.description || '暂无描述'}}</view>
    <view class="btn-wrap">
      <button data-id="{{item.id}}" catchtap="goEdit">编辑</button>
      <button data-id="{{item.id}}" catchtap="goPrices">工价</button>
      <button type="warn" data-id="{{item.id}}" catchtap="confirmDelete">删除</button>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && list.length===0}}">暂无工序</view>
  <view class="no-more" wx:if="{{noMore && list.length>0}}">没有更多了</view>
</view>
