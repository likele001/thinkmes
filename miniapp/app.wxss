/** 全局样式 - 参考 adminweixin 清新时尚风格 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #2D3748;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片 - 与 adminweixin 一致 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.list-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

/* 按钮 - 渐变与 adminweixin 一致 */
.btn {
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  text-align: center;
}
.btn:active { opacity: 0.8; transform: scale(0.98); }

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-success {
  background: linear-gradient(135deg, #34c759 0%, #30d158 100%);
  color: #fff;
}

.btn-danger {
  background: linear-gradient(135deg, #ff4757 0%, #ff6b7a 100%);
  color: #fff;
}

.btn-warning {
  background: linear-gradient(135deg, #ff9500 0%, #ffb340 100%);
  color: #fff;
}

.btn-block { width: 100%; box-sizing: border-box; }

/* 表单 */
.form-item { margin-bottom: 20rpx; }
.form-label {
  display: block;
  margin-bottom: 10rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}
.form-input, .input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.form-input:focus, .input:focus { border-color: #667eea; }

/* 状态标签 */
.status { padding: 8rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; color: #fff; }
.status-pending { background-color: #ff9500; }
.status-success { background-color: #34c759; }
.status-error { background-color: #ff4757; }
.status-info { background-color: #007aff; }
.status-0 { background-color: #ff9500; color: #fff; }
.status-1 { background-color: #667eea; color: #fff; }
.status-2 { background-color: #34c759; color: #fff; }
.status-3 { background-color: #999; color: #fff; }

/* 文字 */
.text-muted { color: #718096; font-size: 24rpx; }
.text-primary { color: #667eea; font-weight: 600; }

/* 行 */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}
.row:last-child { border-bottom: none; }

/* 空状态 / 加载更多 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
.load-more {
  text-align: center;
  padding: 20rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3748;
  margin-bottom: 20rpx;
}

/* ========== 管理端列表页通用（与 adminweixin 对齐）========== */
.admin-page .container {
  padding: 20rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
}

/* 顶部导航栏 */
.top-nav {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
  margin: 0 -20rpx 20rpx -20rpx;
  padding: 0;
}

.top-nav .nav-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-nav .nav-item.active { color: #667eea; font-weight: bold; }
.top-nav .nav-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #667eea;
  border-radius: 2rpx;
}

.header-actions { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.header-actions .btn-primary, .header-actions .btn-success {
  flex: 1;
  border: none;
  border-radius: 25rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #fff;
}
.header-actions .btn-primary { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
.header-actions .btn-success { background: linear-gradient(135deg, #34c759 0%, #30d158 100%); }

.filter-bar {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
}
.filter-bar .picker {
  padding: 12rpx 20rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  text-align: center;
  color: #333;
  font-size: 28rpx;
}

/* 列表项卡片（订单/分工/报工通用） */
.order-item, .report-item, .allocation-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}
.order-header, .report-header, .allocation-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #eee;
}
.order-title, .report-title, .allocation-title { font-size: 32rpx; font-weight: bold; color: #333; }
.order-info .info-row, .report-info .info-row, .allocation-info .info-row {
  display: flex;
  margin-bottom: 10rpx;
}
.order-info .label, .report-info .label, .allocation-info .label {
  width: 140rpx;
  color: #666;
  font-size: 28rpx;
  flex-shrink: 0;
}
.order-info .value, .report-info .value, .allocation-info .value { flex: 1; color: #333; font-size: 28rpx; }
.order-actions, .report-actions { display: flex; gap: 15rpx; margin-top: 20rpx; }
.order-actions button, .report-actions .btn-audit, .report-actions .btn-edit, .report-actions .btn-detail {
  flex: 1;
  border: none;
  border-radius: 20rpx;
  padding: 15rpx;
  font-size: 24rpx;
  color: #fff;
}
.order-actions .btn-edit, .report-actions .btn-edit { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
.order-actions .btn-delete { background: linear-gradient(135deg, #ff4757 0%, #ff6b7a 100%); }
.order-actions .btn-detail, .report-actions .btn-detail { background: linear-gradient(135deg, #34c759 0%, #30d158 100%); }
.report-actions .btn-pass { background: linear-gradient(135deg, #34c759 0%, #30d158 100%); }
.report-actions .btn-reject { background: linear-gradient(135deg, #ff4757 0%, #ff6b7a 100%); }

/* 底部快捷导航（管理端列表页） */
.bottom-nav {
  display: flex;
  background: #fff;
  border-top: 1rpx solid #eee;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}
.bottom-nav .nav-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.bottom-nav .nav-icon { font-size: 40rpx; margin-bottom: 8rpx; }
.bottom-nav .nav-text { font-size: 24rpx; color: #666; }
.bottom-nav .nav-item.active .nav-text { color: #667eea; font-weight: bold; }

/* ========== 通用页头（所有管理端子页）========== */
.page-header-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  padding: 24rpx 30rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}
.page-back {
  font-size: 28rpx;
  color: rgba(255,255,255,0.95);
  margin-right: 24rpx;
  padding: 8rpx 0;
}
.page-title { font-size: 32rpx; font-weight: 700; flex: 1; }
.btn-bar-admin {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.btn-bar-admin .btn-primary, .btn-bar-admin .btn-add {
  flex: 1;
  border: none;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
.card-title { font-size: 30rpx; font-weight: 700; color: #333; margin-bottom: 20rpx; padding-bottom: 12rpx; border-bottom: 2rpx solid #eee; }
.btn-wrap { display: flex; gap: 16rpx; margin-top: 20rpx; }
.btn-wrap button, .btn-row button {
  flex: 1;
  border: none;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #fff;
}
.btn-wrap button:first-child, .btn-row button.btn-primary { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
.btn-wrap button:nth-child(2) { background: linear-gradient(135deg, #34c759 0%, #30d158 100%); }
.btn-wrap button[type="warn"], .btn-row button[type="warn"] { background: linear-gradient(135deg, #ff4757 0%, #ff6b7a 100%); }
.no-more { text-align: center; padding: 24rpx; color: #999; font-size: 26rpx; }
.picker { padding: 20rpx; border: 2rpx solid #eee; border-radius: 12rpx; font-size: 28rpx; color: #333; background: #fff; }
.textarea { min-height: 120rpx; }
.form-textarea { min-height: 120rpx; }
.btn-qrcode { background: linear-gradient(135deg, #34c759 0%, #30d158 100%); color: #fff; }
.btn-approve { background: linear-gradient(135deg, #34c759 0%, #30d158 100%); color: #fff; }
