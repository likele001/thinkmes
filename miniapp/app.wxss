/* ========== MES 工作台 - 全局设计语言 ========== */
page {
  background: linear-gradient(180deg, #f0f4ff 0%, #f8fafc 24%, #f1f5f9 100%);
  font-size: 28rpx;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
}

/* 容器 */
.container {
  padding: 32rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 卡片 - 毛玻璃感 + 轻阴影 */
.card {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(30, 41, 59, 0.08), 0 1rpx 3rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

/* 主按钮 - 渐变 + 圆角 */
.btn-primary {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 50%, #818cf8 100%);
  color: #fff;
  border: none;
  border-radius: 20rpx;
  text-align: center;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.35);
}

/* 次要文字 */
.text-muted {
  color: #64748b;
  font-size: 24rpx;
}

.text-primary {
  color: #4f46e5;
  font-weight: 600;
}

/* 列表行通用 */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}
.row:last-child { border-bottom: none; }
